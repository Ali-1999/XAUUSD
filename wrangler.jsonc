{
  "name": "xauusd-msnr-live",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xauusd-msnr-live",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CLOCK", "class_name": "PaperBotClock" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PaperBotClock"] }]
}
